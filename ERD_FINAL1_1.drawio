        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1035" value="System &amp; Audit" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="2192" y="1172" width="190" height="20" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1036" value="&lt;b&gt;Immutable medical records&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;MedShack visits, treatments, medication doses, and medication events cannot be edited after insert. Corrections create new records with a reference to the original. All changes flow through AUDIT_LOG.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="100" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1037" value="&lt;b&gt;Sibling linking&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Campers in the same family share a family_group_id (UUID). All campers with the same value are siblings. Nullable for unlinked campers.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="260" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1038" value="&lt;b&gt;Per-camp assessment&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;CAMPER_ASSESSMENT has exactly one row per CAMP_REGISTRATION. Diagnosis and treating clinic live on CAMPER (longitudinal). The assessment captures arrival state for that specific camp.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="400" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1039" value="&lt;b&gt;Prescription vs dose&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;PRESCRIPTION = what should happen (the schedule). MEDICATION_DOSE = what actually happened (each individual dose). Status=&#39;missed&#39; flags doses where administered_at is null past the scheduled time + grace window.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="550" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1040" value="&lt;b&gt;USER vs CREW_MEMBER&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Every USER is a CREW_MEMBER, but most CREW_MEMBERs are not USERs. USER controls system login; CREW_MEMBER tracks anyone working at camp (including volunteers).&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="710" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1041" value="&lt;b&gt;Phase 2 candidates&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;VENUE as own entity, PARTNER_ORGANISATION (referring clinics), DOCUMENT_ATTACHMENT (PDF uploads), MEDICATION_CATALOGUE (master drug list). Held for MVP simplicity; revisit after first pilot.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff8c4;strokeColor=#c4b04a;fontSize=12;align=left;verticalAlign=top;spacingTop=4;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="2150" y="850" width="280" height="130" as="geometry" />
        </mxCell>

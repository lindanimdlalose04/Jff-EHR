        <mxCell id="3KrlU2yVGq8G0Gz89wXL-1033" value="Medical Operations" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">

# Copy this file to ".env" on the server and fill in the real values.
# ".env" is gitignored, so real secrets never get committed. Get the values from
# your laptop's existing configuration (see DEPLOY.md for exactly where).

# --- Public Supabase config (from the frontend .env / Supabase dashboard) ---
# The anon key is a public client key, safe to bake into the front-end bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# --- Runtime database connection: the RESTRICTED jff_api role ---
# This is the SAME string the app uses locally (ConnectionStrings:JffEhrDb in
# your dotnet user-secrets). Do NOT use the postgres migrations connection here.
JFF_DB_CONNECTION=Host=aws-0-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=jff_api.YOUR-PROJECT-REF;Password=YOUR-JFF_API-PASSWORD;SSL Mode=Require;Trust Server Certificate=true
